<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.apachegui</groupId>
  <artifactId>ApacheGUI</artifactId>
  <version>1.12.0</version>
  <packaging>war</packaging>
  
  <name>ApacheGUI</name>
  <description>Java based Apache server management GUI</description>
  <url>http://apachegui.net</url>
  
  <properties>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <maven.compiler.release>17</maven.compiler.release>
      <maven.compiler.parameters>true</maven.compiler.parameters>
      <spring-boot.version>3.3.5</spring-boot.version>
      <environment>IX</environment>
      <apachegui.home>${basedir}/environments/${environment}/ApacheGUI</apachegui.home>
      <package.dir>/opt/release</package.dir>
  </properties>

  <dependencyManagement>
      <dependencies>
          <dependency>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-dependencies</artifactId>
              <version>${spring-boot.version}</version>
              <type>pom</type>
              <scope>import</scope>
          </dependency>
      </dependencies>
  </dependencyManagement>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  
  <developers>
    <developer>
      <id>jrossi227</id>
      <name>Jonathan Rossi</name>
      <email>jonathan.m.rossi@gmail.com</email>
      <roles>
        <role>architect</role>
        <role>developer</role>
      </roles>
      <timezone>America/Toronto</timezone>
    </developer>
  </developers>

    <repositories>
        <repository>
            <id>ApacheConfParser-mvn-repo</id>
            <url>https://raw.githubusercontent.com/jrossi227/ApacheConfParser/mvn-repo/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>ApacheGUIJdbc-mvn-repo</id>
            <url>https://raw.githubusercontent.com/jrossi227/ApacheGUIJdbc/mvn-repo/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
    </repositories>
  
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
 </build>
  
  <profiles>
      <profile>
          <id>prod</id>
          <build>
            <finalName>ApacheGUI</finalName>
            <plugins>
              <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
              </plugin>
              <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                  <execution>
                    <id>ant-packagejs</id>
                    <phase>prepare-package</phase>
                    <goals>
                      <goal>run</goal>
                    </goals>
                    <configuration>
                      <target>
                        <property name="webapp.dir" value="${project.build.directory}/packagejs"/>
                        <property name="resources.dir" value="${basedir}/src/main/webapp/resources"/>
                        <ant antfile="build.xml" target="package.js" />
                      </target>
                    </configuration>
                  </execution>
                  <execution>
                    <id>ant-installwebapp</id>
                    <phase>install</phase>
                    <goals>
                      <goal>run</goal>
                    </goals>
                    <configuration>
                      <target>
                        <property name="apachegui.home" value="${apachegui.home}"/>
                        <property name="project.build.directory" value="${project.build.directory}"/>
                        <ant antfile="build.xml" target="install" />
                      </target>
                    </configuration>
                  </execution>
                </executions>
              </plugin>
              <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                  <failOnMissingWebXml>false</failOnMissingWebXml>
                  <warSourceExcludes>resources/**,manual/node_modules/**,manual/auto_suggest_24.js,manual/auto_suggest_22.js,manual/scraper.js</warSourceExcludes>
                  <webResources>
                      <resource>
                        <directory>${project.build.directory}/packagejs</directory>
                        <includes>
                          <include>**/*</include>
                        </includes>
                      </resource>
                      <resource>
                        <directory>${basedir}/src/main/webapp/resources</directory>
                        <targetPath>resources</targetPath>
                        <includes>
                          <include>codemirror/**</include>
                          <include>flot/**</include>
                          <include>images/**</include>
                          <include>jquery/**</include>
                          <include>json/**</include>
                          <include>style/**</include>
                        </includes>
                      </resource>
                  </webResources>
                </configuration>
              </plugin>
            </plugins>
          </build>
      </profile> 
      <profile>
          <id>dev</id>
          <build>
            <finalName>ApacheGUI</finalName>
            <plugins>
              <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
              </plugin>
              <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                  <failOnMissingWebXml>false</failOnMissingWebXml>
                  <warSourceExcludes>manual/node_modules/**,manual/auto_suggest_24.js,manual/auto_suggest_22.js,manual/scraper.js</warSourceExcludes>
                </configuration>
              </plugin>
              <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                  <execution>
                    <id>ant-installwebapp</id>
                    <phase>install</phase>
                    <goals>
                      <goal>run</goal>
                    </goals>
                    <configuration>
                      <target>
                        <property name="apachegui.home" value="${apachegui.home}"/>
                        <property name="project.build.directory" value="${project.build.directory}"/>
                        <ant antfile="build.xml" target="install" />
                      </target>
                    </configuration>
                  </execution>
                </executions>
              </plugin>
            </plugins>
          </build>
      </profile>   
      <profile>
        <id>package</id>
        <build>
            <plugins>
                <plugin>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>default-cli</id>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                              <target>
                                <property name="apachegui.home" value="${apachegui.home}"/>
                                <property name="package.dir" value="${package.dir}"/>
                                  <property name="environment" value="${environment}"/>
                                <property name="version" value="${project.version}" />
                                <property name="dbdir" value="${basedir}/build/db/apacheGUI" />
                                <ant antfile="build.xml" target="buildpackage" />
                              </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </build>
      </profile>
      <profile>
        <id>deb</id>
        <build>
            <finalName>ApacheGUI</finalName>
            <plugins>
                <plugin>
                    <groupId>org.vafer</groupId>
                    <artifactId>jdeb</artifactId>
                    <version>1.10</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>jdeb</goal>
                            </goals>
                            <configuration>
                                <deb>${project.build.directory}/apachegui_${project.version}_all.deb</deb>
                                <controlDir>${basedir}/packaging/deb/control</controlDir>
                                <dataSet>
                                    <data>
                                        <src>${project.build.directory}/ApacheGUI.war</src>
                                        <type>file</type>
                                        <mapper>
                                            <type>perm</type>
                                            <prefix>/opt/apachegui</prefix>
                                            <filemode>644</filemode>
                                        </mapper>
                                    </data>
                                    <data>
                                        <src>${basedir}/packaging/seed/db</src>
                                        <type>directory</type>
                                        <mapper>
                                            <type>perm</type>
                                            <prefix>/usr/share/apachegui/db-default</prefix>
                                            <filemode>644</filemode>
                                        </mapper>
                                    </data>
                                    <data>
                                        <src>${basedir}/packaging/systemd/apachegui.service</src>
                                        <type>file</type>
                                        <mapper>
                                            <type>perm</type>
                                            <prefix>/lib/systemd/system</prefix>
                                            <filemode>644</filemode>
                                        </mapper>
                                    </data>
                                </dataSet>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </build>
      </profile>
  </profiles>
  
  <dependencies>
      <!-- ApacheGUI's own libraries: Apache config parser + JDBC/SQLite data layer -->
      <dependency>
          <groupId>net.apachegui</groupId>
          <artifactId>ApacheConfParser</artifactId>
          <version>1.0.12-SNAPSHOT</version>
      </dependency>
      <dependency>
          <groupId>net.apachegui</groupId>
          <artifactId>apachegui-jdbc</artifactId>
          <version>1.0</version>
      </dependency>
      <!-- SQLite driver: previously provided by the bundled Tomcat's lib directory -->
      <dependency>
          <groupId>org.xerial</groupId>
          <artifactId>sqlite-jdbc</artifactId>
          <version>3.46.1.3</version>
      </dependency>

      <!-- Spring Boot starters (Spring 6 / Jakarta EE 10) -->
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-web</artifactId>
      </dependency>
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-security</artifactId>
      </dependency>
      <!-- Embedded servlet container; provided so the WAR can also deploy to an external container -->
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-tomcat</artifactId>
          <scope>provided</scope>
      </dependency>
      <!-- JSP/Jasper support for the embedded container -->
      <dependency>
          <groupId>org.apache.tomcat.embed</groupId>
          <artifactId>tomcat-embed-jasper</artifactId>
          <scope>provided</scope>
      </dependency>
      <!-- JSTL (Jakarta EE 10) -->
      <dependency>
          <groupId>jakarta.servlet.jsp.jstl</groupId>
          <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
      </dependency>
      <dependency>
          <groupId>org.glassfish.web</groupId>
          <artifactId>jakarta.servlet.jsp.jstl</artifactId>
      </dependency>

      <!-- Route legacy org.apache.log4j (1.x) calls to SLF4J/Logback -->
      <dependency>
          <groupId>org.slf4j</groupId>
          <artifactId>log4j-over-slf4j</artifactId>
      </dependency>

      <!-- JSON / CSV / HTML / IO utilities -->
      <dependency>
          <groupId>org.json</groupId>
          <artifactId>json</artifactId>
          <version>20240303</version>
      </dependency>
      <dependency>
          <groupId>com.opencsv</groupId>
          <artifactId>opencsv</artifactId>
          <version>5.9</version>
      </dependency>
      <dependency>
          <groupId>org.jsoup</groupId>
          <artifactId>jsoup</artifactId>
          <version>1.17.2</version>
      </dependency>
      <dependency>
          <groupId>commons-io</groupId>
          <artifactId>commons-io</artifactId>
          <version>2.16.1</version>
      </dependency>
  </dependencies>
  
</project>
